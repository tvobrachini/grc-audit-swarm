# ─── LLM Provider Keys (priority: Ollama > NVIDIA > Gemini > OpenAI > Groq) ───
# NVIDIA_API_KEY is commented out by default: if set, it silently outranks
# Gemini in the provider-selection order below. Uncomment only if you
# intentionally want NVIDIA NIM to take priority.
# NVIDIA_API_KEY=nvapi-...
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...

# ─── AWS Credentials (read-only IAM role required) ───────────────────────────
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# ─── Storage Paths (override for Docker volume mounts) ───────────────────────
# EVIDENCE_VAULT_PATH=/mnt/evidence_vault
# SESSIONS_PATH=/mnt/data/audit_sessions.json

# ─── Evidence Vault Encryption (optional, strongly recommended in production) ─
# Generate a key: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# VAULT_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# ─── API CORS (comma-separated allow-list; defaults cover local dev) ─────────
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── API Authentication (required for all /api/* routes) ─────────────────────
# Shared bearer token the FastAPI backend requires on every /api/* request.
# In docker-compose, this same value is injected server-side into the
# nginx reverse proxy (see frontend/nginx.conf.template) so the React app
# never has to ship it in its public JS bundle.
# API_AUTH_TOKEN=<a long random string>
# VITE_API_AUTH_TOKEN is DEV-ONLY: it lets `npm run dev` call a local API
# directly, but it bakes the token into the built JS bundle, so it must never
# be set for a production/compose build.

# ─── Runtime Flags ────────────────────────────────────────────────────────────
# DEMO_MODE=0        # Set to 1 for local demo only — bypasses LLM crews
# ENVIRONMENT=local  # Set to production/staging to enable DEMO_MODE guard
