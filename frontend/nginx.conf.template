server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Basic hardening headers. The CSP is scoped to what the built Vite app
    # actually needs: no inline <script>, but React does set inline `style`
    # attributes, hence 'unsafe-inline' on style-src only.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Scanner-findings imports (Prowler JSON): the API accepts files up to
    # 10 MB, so this location allows that plus the multipart envelope. Every
    # other /api/ request keeps the 6 MB cap below.
    location ~ ^/api/sessions/[^/]+/imports/ {
        proxy_set_header Authorization "Bearer ${API_AUTH_TOKEN}";
        # No URI part: a regex location forwards the original request URI.
        proxy_pass http://api:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_cache off;
        client_max_body_size 11m;
    }

    location /api/ {
        # The API requires a bearer token (API_AUTH_TOKEN). We inject it here,
        # server-side, so the token never has to be baked into the public JS
        # bundle or sent by the browser (EventSource cannot set headers).
        # Because every proxied request carries the token, the API refuses
        # state-changing requests whose Origin / Sec-Fetch-Site show they
        # come from another site (src/api/origin_check.py).
        proxy_set_header Authorization "Bearer ${API_AUTH_TOKEN}";
        proxy_pass http://api:8000/api/;
        # $http_host keeps the port, so the API can compare the browser's
        # Origin with the host it actually requested.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_cache off;
        # Scope documents are capped at 5 MB by the API; allow the multipart
        # envelope on top (nginx's default limit is 1 MB).
        client_max_body_size 6m;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
